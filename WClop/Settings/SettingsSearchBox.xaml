<UserControl x:Class="WClop.Settings.SettingsSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The search box above the settings tabs; matches drop down below it. -->
    <Grid>
        <TextBox x:Name="QueryBox" Padding="30,5,8,5" VerticalContentAlignment="Center"
                 AutomationProperties.Name="Search settings"
                 TextChanged="QueryBox_TextChanged" PreviewKeyDown="QueryBox_PreviewKeyDown"
                 GotKeyboardFocus="Focus_Changed" LostKeyboardFocus="Focus_Changed" />
        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Opacity="0.6"
                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
        <TextBlock x:Name="Placeholder" Text="Search settings (Ctrl+F)" Opacity="0.55"
                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="31,0,0,0" IsHitTestVisible="False" />

        <Popup x:Name="ResultsPopup" PlacementTarget="{Binding ElementName=QueryBox}" Placement="Bottom" VerticalOffset="4"
               StaysOpen="True" AllowsTransparency="True" Focusable="False"
               Width="{Binding ActualWidth, ElementName=QueryBox}">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="4">
                <Grid>
                    <ListBox x:Name="ResultsList" MaxHeight="380" BorderThickness="0" Background="Transparent"
                             AutomationProperties.Name="Matching settings"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="ResultsList_Click" PreviewKeyDown="ResultsList_PreviewKeyDown"
                             LostKeyboardFocus="Focus_Changed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Location}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoResults" Text="No settings match" Opacity="0.7" Margin="8,6" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
